# Server configuration
HOST=0.0.0.0
PORT=8000
RELOAD=True
LOG_LEVEL=info

# Database configuration (PostgreSQL required)
# This app only reads — the nem-ingestion service owns the schema and is the
# sole writer. Use docker-compose up to start a local PostgreSQL instance, and
# run the nem-ingestion worker against the same DATABASE_URL for live data.
DATABASE_URL=postgresql://postgres:localdev@localhost:5432/nem_dashboard

# CORS - comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8050

# Conversational agent (Ask NemDash chat tab) — OpenAI
OPENAI_API_KEY=sk-...                  # required for the chat tab
OPENAI_MODEL=gpt-4o                    # optional; defaults to gpt-4o
# OPENAI_BASE_URL=https://...          # optional; for Azure / proxy / compatible endpoints
